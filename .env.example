# Supabase
# Proyecto: szjzaajjpuomvpnghvzu (Piel Canela ERP)
# Obtener en: https://supabase.com/dashboard/project/_/settings/api

# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Anon key (cliente browser, RLS aplicado)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key (server-only, bypassea RLS — NO exponer al cliente)
# Usado por createAdminClient() en src/lib/supabase/admin.ts
SUPABASE_SERVICE_ROLE_KEY=

# --- Acceso al ERP (candado de login) ---
# Contraseña única compartida para entrar al dashboard.
ERP_PASSWORD=

# Secret aleatorio para firmar la cookie de sesión (HS256).
# Generar con: openssl rand -hex 32   — mínimo 16 caracteres.
ERP_AUTH_SECRET=
